
# German Energy Data Platform
# Copy this file to .env and configure your local environment.
# Never commit your actual .env file.

# PostgreSQL connection for Python running on Windows
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=energy_db
DB_USER=energy_user
DB_PASSWORD=replace_with_local_password

# PostgreSQL configuration for Docker Compose
POSTGRES_USER=energy_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=energy_db

# Airflow metadata database
# Use the same password as POSTGRES_PASSWORD.
# If your password contains special URL characters, URL-encode them.
AIRFLOW_DB_URL=postgresql+psycopg2://energy_user:replace_with_local_password@postgres:5432/airflow_db

# Airflow development JWT secret
# Generate a unique secret for your local environment.
AIRFLOW_JWT_SECRET=replace_with_random_secret
